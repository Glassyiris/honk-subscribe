[Unit]
Description=Honk subscription aggregator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vyos
Group=users
WorkingDirectory=/config/honk-sub
ExecStart=/config/honk-sub/honk-subsribe
Environment=HONK_SUBSCRIBE_ADDR=127.0.0.1:8090
Environment=HONK_SUBSCRIBE_DB=/config/honk-sub/honk-subsribe.db
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
